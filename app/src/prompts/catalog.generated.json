{
  "version": 1,
  "recipients": [
    {
      "id": "annotation-label",
      "description": "Built-in quick-label instructions included with selected feedback.",
      "events": [
        {
          "id": "verify-this",
          "delivery": "message_fragment",
          "description": "Tip attached when this feedback label is selected.",
          "body": {
            "kind": "text",
            "id": "annotation-label.verify-this",
            "source": "content/annotations/labels/verify-this.md"
          }
        },
        {
          "id": "show-the-receipt",
          "delivery": "message_fragment",
          "description": "Tip attached when this feedback label is selected.",
          "body": {
            "kind": "text",
            "id": "annotation-label.show-the-receipt",
            "source": "content/annotations/labels/show-the-receipt.md"
          }
        },
        {
          "id": "give-me-an-example",
          "delivery": "message_fragment",
          "description": "Tip attached when this feedback label is selected.",
          "body": {
            "kind": "text",
            "id": "annotation-label.give-me-an-example",
            "source": "content/annotations/labels/give-me-an-example.md"
          }
        },
        {
          "id": "consider-alternatives",
          "delivery": "message_fragment",
          "description": "Tip attached when this feedback label is selected.",
          "body": {
            "kind": "text",
            "id": "annotation-label.consider-alternatives",
            "source": "content/annotations/labels/consider-alternatives.md"
          }
        }
      ]
    },
    {
      "id": "annotation-terminal",
      "description": "Feedback sent from annotated terminal output.",
      "events": [
        {
          "id": "submit",
          "delivery": "user_message",
          "description": "Ordered entries and an optional overall note; the frontend trims trailing JavaScript whitespace.",
          "body": {
            "kind": "text",
            "id": "annotation-terminal.submit",
            "source": "content/annotations/terminal-submit.md",
            "bindings": [
              {
                "name": "note",
                "node": {
                  "kind": "when",
                  "condition": {
                    "field": {
                      "name": "note",
                      "kind": "text",
                      "description": "note"
                    },
                    "test": "present"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "id": "annotation-terminal.note",
                      "source": "content/annotations/terminal-note.md",
                      "keep_final_newline": true,
                      "bindings": [
                        {
                          "name": "note",
                          "node": {
                            "kind": "input",
                            "field": {
                              "name": "note",
                              "kind": "text",
                              "description": "note"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "entries",
                "node": {
                  "kind": "input",
                  "field": {
                    "name": "entries",
                    "kind": "text",
                    "description": "entries",
                    "from": "annotation-terminal/entry"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "entry",
          "delivery": "message_fragment",
          "description": "One terminal selection; the adapter quotes lines and resolves a quick label.",
          "body": {
            "kind": "text",
            "id": "annotation-terminal.entry",
            "source": "content/annotations/terminal-entry.md",
            "keep_final_newline": true,
            "bindings": [
              {
                "name": "index",
                "node": {
                  "kind": "input",
                  "field": {
                    "name": "index",
                    "kind": "text",
                    "description": "index"
                  }
                }
              },
              {
                "name": "heading",
                "node": {
                  "kind": "choose",
                  "condition": {
                    "field": {
                      "name": "heading",
                      "kind": "text",
                      "description": "heading"
                    },
                    "test": "present"
                  },
                  "children": [
                    {
                      "kind": "input",
                      "field": {
                        "name": "heading",
                        "kind": "text",
                        "description": "heading"
                      }
                    },
                    {
                      "kind": "text",
                      "id": "annotation-terminal.comment-heading",
                      "source": "content/annotations/terminal-comment-heading.md",
                      "keep_final_newline": true
                    }
                  ]
                }
              },
              {
                "name": "quote",
                "node": {
                  "kind": "input",
                  "field": {
                    "name": "quote",
                    "kind": "text",
                    "description": "quote"
                  }
                }
              },
              {
                "name": "tip",
                "node": {
                  "kind": "when",
                  "condition": {
                    "field": {
                      "name": "tip",
                      "kind": "text",
                      "description": "tip"
                    },
                    "test": "present"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "id": "annotation-terminal.tip",
                      "source": "content/annotations/terminal-tip.md",
                      "keep_final_newline": true,
                      "bindings": [
                        {
                          "name": "tip",
                          "node": {
                            "kind": "input",
                            "field": {
                              "name": "tip",
                              "kind": "text",
                              "description": "tip"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "comment",
                "node": {
                  "kind": "when",
                  "condition": {
                    "field": {
                      "name": "has_comment",
                      "kind": "flag",
                      "description": "The comment is nonempty."
                    },
                    "test": "enabled"
                  },
                  "children": [
                    {
                      "kind": "text",
                      "id": "annotation-terminal.comment",
                      "source": "content/annotations/terminal-comment.md",
                      "keep_final_newline": true,
                      "bindings": [
                        {
                          "name": "comment",
                          "node": {
                            "kind": "input",
                            "field": {
                              "name": "comment",
                              "kind": "text",
                              "description": "comment"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "sources": {
    "content/annotations/labels/consider-alternatives.md": "Propose 2-3 alternative approaches with trade-offs based on the actual codebase.\n",
    "content/annotations/labels/give-me-an-example.md": "This is too abstract. Show a before/after, a sample input/output, or a specific scenario.\n",
    "content/annotations/labels/show-the-receipt.md": "You asserted this as fact. Name what backs it — the file and line, the measurement, the command output — or say plainly that it is an assumption.\n",
    "content/annotations/labels/verify-this.md": "This seems like an assumption. Verify by reading the actual code before proceeding.\n",
    "content/annotations/terminal-comment-heading.md": "💬 Comment",
    "content/annotations/terminal-comment.md": "{{comment}}\n",
    "content/annotations/terminal-entry.md": "## {{index}}. {{heading}}\n\n\u003e {{quote}}\n\n{{tip}}{{comment}}\n",
    "content/annotations/terminal-note.md": "{{note}}\n\n",
    "content/annotations/terminal-submit.md": "Feedback on your last message.\n\n{{note}}{{entries}}\n",
    "content/annotations/terminal-tip.md": "{{tip}}\n"
  },
