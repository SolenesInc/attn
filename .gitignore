# Claude Code local config. settings.json is the shared, checked-in part (repo
# hooks); everything else here is per-machine. The pattern must exclude the
# directory's contents rather than the directory itself — git cannot re-include a
# file whose parent directory is excluded.
.claude/*
!.claude/settings.json
!.claude/skills/

# Local env files
**/.npmrc

# Native libghostty-vt build output (source of truth: scripts/build-libghostty-vt.sh)
/third_party/


# activity-bench corpus and results: real transcript excerpts, never committed
.activity-bench/

# Local prompt editor drafts and reviews
.prompt-editor/
# The Sheet page's bundle, built by make prompt-editor
/cmd/prompt-editor/web/sheet/dist/
/cmd/attn-ingest/attn-ingest

/internal/ghosttyvt/native_paths_generated_*.go
__pycache__/

# attn website
/website/dist/
/website/.astro/
