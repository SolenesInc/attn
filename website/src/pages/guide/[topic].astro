---
import { getCollection, type CollectionEntry } from 'astro:content';
import GuidePage from '../../layouts/GuidePage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guide', (entry) => entry.id !== 'README');
  return entries.map((entry) => ({ params: { topic: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'guide'> };
---

<GuidePage entry={entry} />
