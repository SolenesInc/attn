  <symbol id="i-codex" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z"/></symbol>
  <symbol id="i-enter" viewBox="0 0 24 24"><path d="M20 5v8a3 3 0 0 1-3 3H5"/><path d="m9 11-5 5 5 5"/></symbol>
</svg>

<section id="hero">
  <svg id="edge" aria-hidden="true"></svg>
  <canvas id="lights" aria-hidden="true"></canvas>
  <canvas id="field" aria-hidden="true"></canvas>
  <header class="bar">
    <a class="mark" href="/">attn</a>
    <a data-wide href="/guide/">Guide</a>
    <a data-wide href="https://github.com/SolenesInc/attn">GitHub</a>
    <a class="install" href="#homepane" id="jump">Install</a>
  </header>
  <div id="spot"></div>
  <h1 id="h1">Agents scale. Your attention doesn’t.</h1>
  <p class="sub">A terminal multiplexer for orchestrating <span class="cc"><svg class="logo" aria-hidden="true"><use href="#i-claude"/></svg>Claude Code</span> and <span class="cx"><svg class="logo" aria-hidden="true"><use href="#i-codex"/></svg>Codex.</span></p>

  <div class="win" id="win" aria-label="A working miniature of attn, with agents waiting for you">
    <div class="tb" aria-hidden="true">
      <span class="left">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="tool new">New</span>
        <span class="tool bolt"><svg viewBox="0 0 16 16"><path d="M9.5 1.5 3 9h4l-.5 5.5L13 7H9z"/></svg></span>
        <span class="tool"><svg viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="9" rx="1.5"/><path d="M8 11v3M5.500 14h5"/></svg></span>
        <span class="tool"><svg viewBox="0 0 16 16"><path d="m10 3-5 5 5 5"/></svg></span>
        <span class="tool"><svg viewBox="0 0 16 16"><path d="M4 7a4 4 0 0 1 8 0c0 4 1.500 5 1.500 5h-11S4 11 4 7M6.800 14a1.400 1.400 0 0 0 2.400 0"/></svg></span>
      </span>
      <span class="shelf" id="shelf"></span>
      <span class="end">
        <span class="plain"><svg viewBox="0 0 16 16"><path d="M8 14V7M8 7c0-2.500-1.800-4-4.500-4 0 2.500 1.800 4 4.500 4ZM8 9c0-2.200 1.700-3.500 4.500-3.500C12.500 7.700 10.800 9 8 9Z"/></svg></span>
        <span class="plain"><svg viewBox="0 0 16 16"><rect x="3" y="2" width="10" height="12" rx="1"/><path d="M6 2v12M8.500 5.500h2M8.500 8h2"/></svg></span>
        <span class="plain"><svg viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="10" rx="1.500"/><path d="m5 6.500 2 1.500-2 1.500M8.500 10H11"/></svg></span>
        <span class="plain"><svg viewBox="0 0 16 16"><path d="m8 2 1.800 3.800 4.200.6-3 2.900.7 4.200L8 11.500l-3.700 2 .7-4.200-3-2.900 4.200-.6z"/></svg></span>
        <span class="profile">Default<span>▾</span></span>
      </span>
    </div>
    <aside class="sb" id="sb">
      <button class="homebtn" id="homebtn" type="button" aria-label="Home">
        <svg class="home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8M5 9.500V21h5v-6h4v6h5V9.500"/></svg><span>Home</span><kbd>⌘⇧H</kbd>
      </button>
      <p class="count" id="count"></p>
      <ul id="rows"></ul>
      <p class="more" id="more"></p>
      <p class="nworking" id="nworking"></p>
      <div class="keywrap" id="keywrap">
        <button class="key" id="key" type="button">
          <svg class="enter" aria-hidden="true"><use href="#i-enter"/></svg>
          <span>Send and go to next</span>
          <span class="fill" id="fill"></span>
        </button>
      </div>
      <div class="strip" aria-hidden="true">
        <div class="dchips"><span class="cur">1<i id="dwait"></i></span><span>⊞</span></div>
        <p>Desktop 1<kbd>⌘G</kbd></p>
      </div>
    </aside>
    <div class="main">
      <section class="tile" id="side" aria-hidden="true">
        <div class="head"><div><i class="light"></i><b id="s-name"></b></div><small id="s-h"></small></div>
        <div class="term" id="s-term"></div>
      </section>
      <section class="tile" id="front">
        <span class="corner a"></span><span class="corner b"></span>
        <div class="head"><div><i class="light"></i><b id="f-name"></b></div><small id="f-h"></small></div>
        <div class="term" id="f-term"></div>
      </section>
      <div id="homepane">
        <p class="settled"><i></i><span id="state">All caught up</span></p>
        <div class="cmds">
          <pre><span><i>$ </i>brew tap solenesinc/attn https://github.com/SolenesInc/attn</span><span><i>$ </i>brew install --cask solenesinc/attn/attn</span></pre>
          <button class="key" id="copy" type="button">
            <span id="copylabel">Copy</span>
            <svg class="enter" aria-hidden="true"><use href="#i-enter"/></svg>
          </button>
        </div>
        <div class="homelinks">
          <a href="/guide/">Guide</a>
          <a href="https://github.com/SolenesInc/attn">GitHub</a>
          <button id="again" type="button"></button>
        </div>
      </div>
    </div>
  </div>
  <div id="endstage"></div>
</section>


<div id="sections"><LandingSections /></div>
<footer class="foot"><a href="/about/">About</a><span>GPL-3.0</span></footer>
<p class="sr" id="status" role="status"></p>

<script is:inline set:html={homeScript}></script>
<script is:inline set:html={sectionsScript}></script>
</body>
</html>
