---
import '../styles/features.css';
import '../styles/landing.css';
import FeatureList from '../components/FeatureList.astro';
import QueueDemo from '../components/QueueDemo.astro';
import Recording from '../components/Recording.astro';
import Base from '../layouts/Base.astro';

const INSTALL = [
  'brew tap victorarias/attn https://github.com/victorarias/attn',
  'brew install --cask victorarias/attn/attn',
];
const REPO = 'https://github.com/SolenesInc/attn';

const doing = [
  {
    title: 'Durability',
    guide: '/guide/sessions#durability',
    text: 'Restart the attn app, its daemon, even your computer. Open attn again and your agents and terminals are still there, waiting for you.',
  },
  {
    title: 'Bring your own harness',
    guide: '/guide/getting-started#before-you-install',
    text: "attn runs Claude Code and Codex as they are, and other CLI agents through plugins. You get their native experience, but better. A big lab ships a fancy new feature? You get it immediately, as they designed it. Tired of attn? Just use the harness in the terminal.",
  },
  {
    title: 'The queue mode',
    guide: '/guide/queue',
    text: 'A (currently non-default) mode for running many agents at once with lower cognitive overload. Agents are either "waiting for you" or "busy"; after every prompt attn moves you to the next one that needs you, so you don\'t waste cycles picking. Simple, very powerful. Trust me, you want to try it.',
  },
  {
    title: 'The Garden',
    guide: '/guide/delegation#the-garden',
    text: "attn's own task tracking. Work items are seeds you plant, agents tend them, and they get harvested. Like beads, but inside attn.",
  },
  {
    title: 'Visible orchestration',
    guide: '/guide/delegation',
    text: 'Agents delegate to other full-blown agents (not subagents) that you can inspect and steer, from any harness to any harness. Plan with Fable in Claude Code, implement in Codex with Sol, review back in Claude Code with Opus. Agents can even message each other and arrange a party.',
  },
  {
    title: 'Crew members',
    guide: '/guide/crew',
    text: "Custom permanent agents, each with its own charter. There's also the Chief that keeps track of your agents and helps you delegate, the executive assistant for your neurospicy brain.",
  },
  {
    title: 'Automations',
    guide: '/guide/automations',
    text: 'Start a steerable agent on a schedule or on an event (a review request on a PR, say) and get back a ready review guide + assessment.',
  },
  {
    title: 'Annotate anything, send it to the agent',
    guide: '/guide/annotations',
    text: 'Opt/alt-select text in a live terminal, or in a markdown file attn renders natively, leave your comments, and send the whole batch to the agent as one message.',
  },
];
---

<Base
  title="attn: attention hub for AI agents"
  description="attn is an attention hub for AI agents. It runs Claude Code and Codex as they are, and after every prompt it moves you to the next agent that needs you."
>
  <main id="main" class="landing">
    <section class="hero">
      <div class="hero-words">
        <h1>your head shouldn't feel like concrete by 3pm</h1>
        <p class="hero-lede">
          attn is an attention hub for AI agents. It runs Claude Code and Codex as they are, and after every prompt it moves you
          to the next agent that needs you, so you don't waste cycles picking.
        </p>
        <div class="install" data-install>
          <p class="install-where">On a Mac (Apple Silicon), with Homebrew</p>
          <pre class="install-commands"><code>{INSTALL.map((command) => <span>{command}</span>)}</code></pre>
          <button class="install-copy" type="button" data-copy={INSTALL.join('\n')}>Copy</button>
        </div>
        <p class="hero-links">
          <a href="/guide/">Read the guide</a>
          <a href="#install">Other ways to install</a>
        </p>
      </div>
      <QueueDemo />
    </section>

    <section class="story">
      <h2>Why I built it</h2>
      <p>
        I built attn after noticing a pattern: I'd start the day sharp, spin up 4-5 AI agents across different repos, and by
        mid-afternoon my brain was soup. Not from the coding, from the <em>managing</em>. Which terminal has the agent that's
        stuck? Did that one finish? Wait, who asked me a question 20 minutes ago? Alt-tab, alt-tab, alt-tab, scroll, squint,
        repeat.
      </p>
    </section>

    <section class="loop">
      <h2>The queue in the real app</h2>
      <p>
        Open the command palette with Cmd+Shift+K (Ctrl+Alt+K on Linux) and run "Turn on the agent queue". <a href="/guide/queue">The queue guide</a> has the rest.
      </p>
      <Recording id="queue-loop" />
    </section>

    <section class="doing">
      <h2>What attn does</h2>
      <div class="doing-grid">
        {
          doing.map((item) => (
            <div class="doing-item">
              <h3><a href={item.guide}>{item.title}</a></h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
      <p class="doing-more">There are more features, but those are the ones I use every day and am proud about.</p>
    </section>

    <section class="new">
      <h2>What's new</h2>
      <FeatureList />
    </section>

    <section class="note">
      <div class="note-words">
        <h2>A note about this project</h2>
        <p>I built attn because I needed it. Managing multiple agents was the bottleneck, not the coding itself.</p>
        <p>Alpha. I use it every day. It's rough around the edges, but it works really well once you get going.</p>
        <p>
          I work full time, and I have 2 dogs and 4 cats at home. Free time is not abundant. attn is open source, but if you need
          changes I can't get to, <a href={REPO}><strong>fork it</strong></a>. That's encouraged, not rude.
        </p>
        <p>Licensed under <a href={`${REPO}/blob/main/LICENSE`}>GPL-3.0</a>.</p>
      </div>
      <div class="note-install" id="install">
        <h2>Install</h2>
        <p>On a Mac (Apple Silicon), use the Homebrew commands at the top of this page.</p>
        <p>
          Or grab the DMG from the <a href={`${REPO}/releases/latest`}>latest release</a>, open it and drag attn to Applications. The
          app tells you when a new release is out.
        </p>
        <p>
          The Linux app is still in progress; build it from source as <a href="/guide/getting-started#linux">getting started</a> describes. The daemon and CLI run on Linux too.
        </p>
      </div>
    </section>
  </main>
</Base>

<script>
  const box = document.querySelector<HTMLElement>('[data-install]')!;
  const button = box.querySelector<HTMLButtonElement>('[data-copy]')!;
  const commands = box.querySelector('code')!;

  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy!);
      button.textContent = 'Copied';
    } catch {
      getSelection()?.selectAllChildren(commands);
      button.textContent = 'Selected, press Cmd+C';
    }
  });
</script>
