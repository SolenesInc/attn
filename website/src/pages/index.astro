---
import LandingSections from '../components/LandingSections.astro';
import '../landing/fonts.css';
import '../landing/sections.css';
import '../landing/home.css';
import homeScript from '../landing/home.js?raw';
import sectionsScript from '../landing/sections.js?raw';
---

<!doctype html>
<html lang="en" class="nojs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>attn</title>
<meta name="description" content="Agents scale. Your attention doesn’t. A terminal multiplexer for orchestrating Claude Code and Codex.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/mona-sans.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.className = 'js'</script>
</head>
<body>
