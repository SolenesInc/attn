---
import { render } from 'astro:content';
import '../../styles/prose.css';
import '../../styles/features.css';
import Recording from '../../components/Recording.astro';
import { orderedFeatures } from '../../features';
import Base from '../../layouts/Base.astro';
import type { RecordingId } from '../../recordings';

export async function getStaticPaths() {
  const features = await orderedFeatures();
  return features.map((feature, index) => ({
    params: { slug: feature.id },
    props: { feature, previous: features[index - 1], next: features[index + 1] },
  }));
}

const { feature, previous, next } = Astro.props;
const { title, summary, guide } = feature.data;
const { Content } = await render(feature);
---

<Base title={`${title} | attn`} description={summary}>
  <main id="main" class="feature">
    <a class="label feature-back" href="/features">Features</a>
    <h1>{title}</h1>
    <p class="feature-summary">{summary}</p>
    <Recording id={feature.id as RecordingId} />
    <article class="prose"><Content /></article>

    <section class="feature-guide">
      <h2 class="label">In the guide</h2>
      <ul>
        {guide.map((entry) => <li><a href={`/guide/${entry.link}`}>{entry.label}</a></li>)}
      </ul>
    </section>

    <nav class="guide-pager" aria-label="Previous and next feature">
      {
        previous && (
          <a class="guide-pager-previous" href={`/features/${previous.id}`}>
            <span class="label">Previous</span>
            <code>{previous.id}</code>
          </a>
        )
      }
      {
        next && (
          <a class="guide-pager-next" href={`/features/${next.id}`}>
            <span class="label">Next</span>
            <code>{next.id}</code>
            <span class="guide-pager-summary">{next.data.summary}</span>
          </a>
        )
      }
    </nav>
  </main>
</Base>
