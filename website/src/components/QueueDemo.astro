---
const agents = [
  {
    name: 'search-by-ingredient',
    asks: 'Search works. Should an empty query return every recipe, or none?',
    reply: 'none, and show the search tips',
  },
  {
    name: 'fix-unit-conversion',
    asks: 'Found it: cups get rounded before scaling. The fix is ready. Want a regression test?',
    reply: 'yes, then commit',
  },
  {
    name: 'Run the tests',
    asks: 'Three tests fail, all in pantry. Should I fix them?',
    reply: 'yes, fix them',
    worked: 41,
    finishesIn: 7,
  },
];
const waiting = agents.filter((agent) => agent.worked === undefined);
const working = agents.filter((agent) => agent.worked !== undefined);

function rowProps(agent: (typeof agents)[number]) {
  return {
    'data-row': agent.name,
    'data-worked': agent.worked,
    'data-finishes-in': agent.finishesIn,
    disabled: agent.worked !== undefined,
  };
}
---

<figure class="queue-demo">
  <div class="queue" data-queue role="group" aria-label="A working miniature of attn's queue">
    <div class="queue-side">
      <p class="queue-home" data-home>Home</p>
      <p class="queue-label"><span data-waiting-count>{waiting.length}</span> waiting</p>
      <ul class="queue-rows" data-waiting>
        {
          waiting.map((agent) => (
            <li>
              <button class="queue-row" type="button" {...rowProps(agent)}>
                <span class="queue-name">{agent.name}</span>
                <span class="queue-clock" />
              </button>
            </li>
          ))
        }
      </ul>
      <p class="queue-label">Working</p>
      <ul class="queue-rows" data-working>
        {
          working.map((agent) => (
            <li>
              <button class="queue-row" type="button" {...rowProps(agent)}>
                <span class="queue-name">{agent.name}</span>
                <span class="queue-clock">{agent.worked}s</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="queue-main">
      <div class="queue-panes">
        {
          agents.map((agent, index) => (
            <div class:list={['queue-pane', { 'is-on': index === 0 }]} data-pane={agent.name}>
              <p class="queue-title">{agent.name}</p>
              <p class="queue-asks">{agent.asks}</p>
              <p class="queue-reply"><span aria-hidden="true">&gt; </span>{agent.reply}</p>
            </div>
          ))
        }
        <div class="queue-pane" data-pane="Home">
          <p class="queue-settled">All settled</p>
          <p class="queue-follow"><span class="queue-tick" aria-hidden="true"></span>Take me to the next agent that needs you</p>
        </div>
      </div>
      <button class="queue-action" type="button" data-action>
        <span data-action-label>Settle</span>
        <kbd>Enter</kbd>
      </button>
    </div>
    <p class="queue-status" data-status aria-live="polite"></p>
  </div>
  <figcaption>
    A miniature of the queue. Press Enter or click Settle, and attn takes you to the next agent waiting. In the app the key is
    Cmd+Shift+E (Ctrl+Alt+E on Linux).
  </figcaption>
</figure>

<script>
  interface Agent {
    name: string;
    row: HTMLButtonElement;
    pane: HTMLElement;
    clock: HTMLElement;
    startsWorked: number | null;
    startsFinishingIn: number;
    worked: number;
    finishesIn: number;
  }

  const TICK_MS = 1000;
  const MOVE_MS = 180;

  const root = document.querySelector<HTMLElement>('[data-queue]')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const part = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  const waitingList = part('[data-waiting]');
  const workingList = part('[data-working]');
  const homeRow = part('[data-home]');
  const homePane = part('[data-pane="Home"]');
  const waitingCount = part('[data-waiting-count]');
  const status = part('[data-status]');
  const action = part<HTMLButtonElement>('[data-action]');
  const actionLabel = part('[data-action-label]');

  const agents: Agent[] = [...root.querySelectorAll<HTMLButtonElement>('[data-row]')].map((row) => ({
    name: row.dataset.row!,
    row,
    pane: part(`[data-pane="${row.dataset.row}"]`),
    clock: row.querySelector<HTMLElement>('.queue-clock')!,
    startsWorked: row.dataset.worked === undefined ? null : Number(row.dataset.worked),
    startsFinishingIn: Number(row.dataset.finishesIn ?? 0),
    worked: 0,
    finishesIn: 0,
  }));

  let queue: Agent[] = [];
  let working: Agent[] = [];
  let on: Agent | null = null;
  let inView = true;
  let timer = 0;

  function start() {
    for (const agent of agents) {
      agent.worked = agent.startsWorked ?? 0;
      agent.finishesIn = still ? 0 : agent.startsFinishingIn;
    }
    working = agents.filter((agent) => agent.finishesIn > 0);
    queue = agents.filter((agent) => !working.includes(agent));
    on = queue[0];
    render();
  }

  function settle(agent: Agent) {
    const position = queue.indexOf(agent);
    queue.splice(position, 1);
    working.push(agent);
    agent.worked = 0;
    on = queue[position] ?? queue[0] ?? null;
    render();
  }

  function act() {
    if (on) settle(on);
    else if (!working.some((agent) => agent.finishesIn > 0)) start();
  }

  function tick() {
    const finished: Agent[] = [];
    for (const agent of working) {
      agent.worked += 1;
      agent.clock.textContent = `${agent.worked}s`;
      if (agent.finishesIn > 0) {
        agent.finishesIn -= 1;
        if (agent.finishesIn === 0) finished.push(agent);
      }
    }
    if (finished.length === 0) return;
    working = working.filter((agent) => !finished.includes(agent));
    queue.push(...finished);
    on ??= finished[0];
    render();
  }

  function render() {
    const moved = agents.map((agent) => agent.row.getBoundingClientRect().top);
    waitingList.replaceChildren(...queue.map((agent) => agent.row.parentElement!));
    workingList.replaceChildren(...working.map((agent) => agent.row.parentElement!));
    for (const agent of agents) {
      const isWorking = working.includes(agent);
      agent.row.disabled = isWorking;
      agent.clock.textContent = isWorking && !still ? `${agent.worked}s` : '';
      agent.pane.classList.toggle('is-on', agent === on);
      if (agent === on) agent.row.setAttribute('aria-current', 'true');
      else agent.row.removeAttribute('aria-current');
    }
    homePane.classList.toggle('is-on', on === null);
    homeRow.classList.toggle('is-on', on === null);
    waitingCount.textContent = String(queue.length);
    const nobodyLeft = on === null && !working.some((agent) => agent.finishesIn > 0);
    actionLabel.textContent = on ? 'Settle' : nobodyLeft ? 'Start over' : "Nobody's waiting";
    action.setAttribute('aria-disabled', String(on === null && !nobodyLeft));
    status.textContent = on ? `On ${on.name}. ${queue.length} waiting.` : 'Home. All settled.';
    if (!still) {
      agents.forEach((agent, index) => {
        const from = moved[index] - agent.row.getBoundingClientRect().top;
        if (from !== 0) agent.row.animate([{ transform: `translateY(${from}px)` }, { transform: 'none' }], MOVE_MS);
      });
    }
  }

  function runClockOnlyWhileSeen() {
    const run = !still && inView && !document.hidden;
    if (run && !timer) timer = window.setInterval(tick, TICK_MS);
    if (!run && timer) {
      clearInterval(timer);
      timer = 0;
    }
  }

  for (const agent of agents) {
    agent.row.addEventListener('click', () => {
      on = agent;
      render();
      action.focus();
    });
  }

  action.addEventListener('click', act);

  document.addEventListener('keydown', (event) => {
    const nothingFocused = !document.activeElement || document.activeElement === document.body;
    if (event.key !== 'Enter' || event.repeat || !nothingFocused || !inView) return;
    if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    event.preventDefault();
    act();
  });

  document.addEventListener('visibilitychange', runClockOnlyWhileSeen);

  new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    runClockOnlyWhileSeen();
  }).observe(root);

  start();
</script>
