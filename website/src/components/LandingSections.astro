<div class="attn-sections" data-as-root>
  <div class="as-field" aria-hidden="true"><canvas></canvas></div>

  <section class="as-sec" id="as-queue" data-section="queue">
    <h2>Stop checking on your agents</h2>
    <p class="as-line">Reply and walk away. attn brings each one back when it needs you.</p>
    <figure class="as-shot" style="--as-pos:62%">
      <video class="as-media" muted loop playsinline preload="none" poster="/footage/queue.webp" aria-label="Answering a Claude Code agent and moving on, landing on the next agent that needs you with the chain of agents that started it, answering it and moving on again">
        <source src="/footage/queue.mp4" type="video/mp4">
      </video>
      <i class="as-corners" aria-hidden="true"></i>
    </figure>
  </section>

  <section class="as-sec" id="as-handoff" data-section="handoff">
    <h2>Delegate without letting go</h2>
    <p class="as-line">Hands-on when you want. Delegate the rest. Jump in when it matters.</p>
    <figure class="as-shot" style="--as-pos:60%">
      <video class="as-media" muted loop playsinline preload="none" poster="/footage/handoff.webp" aria-label="A Claude Code agent starts a Codex agent and a Claude Code agent for two parts of a job; you open the Codex one from the chain of agents and answer its question">
        <source src="/footage/handoff.mp4" type="video/mp4">
      </video>
      <i class="as-corners" aria-hidden="true"></i>
    </figure>
  </section>

  <section class="as-sec" id="as-plan" data-section="plan">
    <h2>Keep the work out of your head</h2>
    <p class="as-line">One plan, shared by you and your agents.</p>
    <figure class="as-shot" style="--as-pos:80%">
      <video class="as-media" muted loop playsinline preload="none" poster="/footage/plan.webp" aria-label="Opening a plan and its pieces, commenting on a decision in the plan and sending it to the agent, which rewrites that decision and reports one of the plan's checks as done">
        <source src="/footage/plan.mp4" type="video/mp4">
      </video>
      <i class="as-corners" aria-hidden="true"></i>
    </figure>
  </section>

  <section class="as-sec" id="as-room" data-section="room">
    <h2>Dozens of agents, no clutter</h2>
    <p class="as-line">Keep what you're working on in view. Give each project its own desktop.</p>
    <figure class="as-shot" style="--as-pos:50%">
      <video class="as-media" muted loop playsinline preload="none" poster="/footage/room.webp" aria-label="Editing a file in Vim beside a Codex agent on the same job, moving along the tiles for that job, then switching to a second desktop holding a different project and back">
        <source src="/footage/room.mp4" type="video/mp4">
      </video>
      <i class="as-corners" aria-hidden="true"></i>
    </figure>
  </section>

  <section class="as-sec" id="as-keyboard" data-section="keyboard">
    <h2>Built for the keyboard</h2>
    <p class="as-line"><kbd>⌘K</kbd> finds an agent. <kbd>⌘⇧K</kbd> runs any command.</p>
    <figure class="as-shot" style="--as-pos:58%">
      <video class="as-media" muted loop playsinline preload="none" poster="/footage/keyboard.webp" aria-label="Searching agents with Command K, then listing every command with Command Shift K">
        <source src="/footage/keyboard.mp4" type="video/mp4">
      </video>
      <i class="as-corners" aria-hidden="true"></i>
    </figure>
  </section>
</div>
