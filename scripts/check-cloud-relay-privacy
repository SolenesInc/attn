#!/usr/bin/env bash
set -euo pipefail

# attn owns the Cloud Relay contract and knows a Cloud Relay only by its URL. The wire's signed strings start with attn-cloud/v1, which stays.
refused='attn-cloud|durable object|workerd([^a-z]|$)|miniflare|cloudflare'
found="$(git grep -nIiE "$refused" -- ':!scripts/check-cloud-relay-privacy' ':!scripts/check-cloud-relay-privacy_test.sh' \
  | sed 's#attn-cloud/v1##g' | grep -iE "$refused" || true)"
if [ -n "$found" ]; then
  echo "check-cloud-relay-privacy: attn must not name a Cloud Relay's repository or how a Cloud Relay is built:" >&2
  echo "$found" >&2
  echo "Point at docs/internal/cloud-relay-contract.md, or drive a Cloud Relay by its URL (ATTN_CLOUD_RELAY_URL, ATTN_CLOUD_URL)." >&2
  exit 1
fi
