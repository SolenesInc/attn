#!/usr/bin/env bash
# The native app's screenshot tour: native/crates/attn-app/examples/screenshot_tour.rs draws a
# fixed set of screens offscreen, in dark and in light, one PNG each.
#
#   scripts/native-screenshot-tour shoot [--scheme ID] [--only PATTERN]... [--window WxH]
#                                        [--text SCALE] [--long] OUT [REV]
#       the tour of this checkout, or of REV, with the color_scheme setting at ID; with --only,
#       only the screens whose names match a PATTERN, where * stands for any characters; with
#       --window, --text or --long, in a WxH window, at SCALE text, with every name long
#   scripts/native-screenshot-tour diff BASE AFTER DIFF
#
# shoot REV checks REV out in this checkout's base worktree, native/target/screenshot-tour-base,
# with this checkout's tour; a revision that pins a Rune without ElementInfo::text_overflow fails
# to build with it. The base worktree stays between runs with its own build directory, so a run
# compiles only what changed since the last. diff writes one image per changed screen to DIFF,
# each changed pixel in red, and exits 1 when any pixel differs or AFTER's clips.tsv or
# overlaps.tsv lists text BASE's does not. Both build in release.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tour="native/crates/attn-app/examples/screenshot_tour.rs"
base="$root/native/target/screenshot-tour-base"

usage() {
  sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

absolute() {
  mkdir -p "$1"
  (cd "$1" && pwd)
}

vt_archive() {
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
  arm64 | aarch64) arch=arm64 ;;
  *) arch=amd64 ;;
  esac
  echo "third_party/ghostty-vt/${os}_${arch}/lib/libghostty-vt.a"
}

build_dir() {
  echo "${CARGO_HOME:-$HOME/.cargo}/attn-native-build$(cd "$1/native" && pwd -P)"
}

check_out_base() {
  local rev
  rev="$(git -C "$root" rev-parse --verify "$1^{commit}")"
  if [ -e "$base/.git" ]; then
    git -C "$base" checkout --quiet --force --detach "$rev"
  else
    git -C "$root" worktree prune
    git -C "$root" worktree add --detach "$base" "$rev" >/dev/null
  fi
  mkdir -p "$(dirname "$base/$tour")"
  cp -p "$root/$tour" "$base/$tour"
  if [ -d "$root/third_party/ghostty-vt" ] && [ ! -e "$base/third_party/ghostty-vt" ]; then
    mkdir -p "$base/third_party"
    cp -Rp "$root/third_party/ghostty-vt" "$base/third_party/"
  fi
}

run_tour() {
  local checkout="$1"
  shift
  (cd "$checkout/native" && CARGO_BUILD_BUILD_DIR="$(build_dir "$checkout")" cargo run --release --locked -q -p attn-app --example screenshot_tour -- "$@")
}

shoot() {
  local flags=()
  while true; do
    case "${1:-}" in
    --scheme | --only | --window | --text)
      flags+=("$1" "${2:?$1 takes a value}")
      shift 2
      ;;
    --long)
      flags+=("$1")
      shift
      ;;
    *) break ;;
    esac
  done
  [ $# -ge 1 ] || usage
  local out rev="${2:-}" checkout="$root"
  out="$(absolute "$1")"
  if [ -n "$rev" ]; then
    check_out_base "$rev"
    checkout="$base"
  fi
  make -C "$checkout" -s "$(vt_archive)"
  find "$out" -name '*.png' -delete
  rm -f "$out/cost.tsv" "$out/clips.tsv" "$out/overlaps.tsv" "$out/failed.txt"
  run_tour "$checkout" shoot "$out" ${flags[@]+"${flags[@]}"}
  echo "native-screenshot-tour: wrote $(find "$out" -name '*.png' | wc -l | tr -d ' ') screens to $out"
}

diff_runs() {
  local base after diff
  base="$(absolute "$1")"
  after="$(absolute "$2")"
  diff="$(absolute "$3")"
  find "$diff" -name '*.png' -delete
  run_tour "$root" compare "$base" "$after" "$diff"
}

case "${1:-}" in
shoot) [ $# -ge 2 ] || usage; shoot "${@:2}" ;;
diff) [ $# -eq 4 ] || usage; diff_runs "${@:2}" ;;
*) usage ;;
esac
