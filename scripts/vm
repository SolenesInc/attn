#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
scripts/vm: run this checkout's attn in a shared macOS VM.

  scripts/vm up                     build if stale, get a VM, install, open, wait until ready
  scripts/vm drive ACTION [JSON]    send one automation-bridge action to the app
  scripts/vm record SECONDS OUT.mp4 record the app's window; one recording at a time per VM
  scripts/vm shot OUT.png           screenshot the app's window
  scripts/vm down                   quit and clean this instance and release the VM
  scripts/vm adopt                  take an instance with no owner, started by an earlier
                                    scripts/vm, when it is yours

APP=native runs the native app (native/crates/attn-app) instead of the Tauri app;
drive then takes the native app's automation actions.

Each agent gets its own instance by default, vm-<worktree name>-<hash>. --instance
NAME, before or right after the command, selects another; a name another agent is
using in the VM is refused, and so is one that has no owner. macvm ls shows every VM.
EOF
    exit 2
}

die() {
    printf 'scripts/vm: %s\n' "$*" >&2
    exit 1
}

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
command -v macvm >/dev/null || die "macvm is not on PATH; it comes from shell-config (run: shell-config apply)"

READY_LIMIT_SECONDS=600

holder="$(macvm holder)" || die "macvm has no holder command; update it with: shell-config apply"

default_instance() {
    local name
    name="$(basename "$root" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-')"
    name="vm-${name#attn--}"
    printf '%s-%s' "${name:0:11}" "$(printf '%s\n%s' "$root" "$holder" | shasum | cut -c1-4)"
}

instance=""
command=""
args=()
while [ $# -gt 0 ]; do
    if [ "$1" = --instance ] && [ -z "$instance" ] && [ ${#args[@]} -eq 0 ]; then
        [ $# -ge 2 ] || usage
        instance="$2"
        shift 2
    elif [ -z "$command" ]; then
        command="$1"
        shift
    else
        args+=("$1")
        shift
    fi
done
[ -n "$command" ] || usage
instance="${instance:-$(default_instance)}"
attn instance resolve --instance "$instance" --field wsPort >/dev/null ||
    die "instance name '$instance' was refused by attn; pass another with --instance"

app="attn-$instance"
shell="${APP:-tauri}"
case "$shell" in
tauri) bundle="app/src-tauri/target/staged/$app.app" ;;
native) bundle="native/target/staged/$app.app" ;;
*) die "APP must be tauri or native, got: $shell" ;;
esac
guest_app="Applications/$app.app"
guest_bin="/Users/admin/$guest_app/Contents/MacOS/attn"
harness="h/$instance"
owner_link="vm-instance-owners/$instance"
export MACVM_LABEL="scripts/vm $instance"

bundle_fingerprint() { jq -r .sourceFingerprint "$bundle/Contents/Resources/build-identity.json" 2>/dev/null || true; }
guest_fingerprint() {
    macvm exec cat "$guest_app/Contents/Resources/build-identity.json" 2>/dev/null | jq -r .sourceFingerprint 2>/dev/null || true
}

bridge() {
    macvm exec env ATTN_HARNESS_INSTANCE="$instance" ATTN_HARNESS_BIN="$guest_bin" \
        node "$harness/app/scripts/real-app-harness/ui-automation-cli.mjs" "$@"
}

instance_owner() { macvm exec readlink "$owner_link" 2>/dev/null || true; }

link_owner_when_app_is() {
    macvm exec /bin/sh -c '
        mkdir -p "$(dirname "$1")"
        if [ -e "$3" ]; then app=installed; else app=absent; fi
        [ "$app" != "$4" ] || ln -s "$2" "$1" 2>/dev/null
        readlink "$1"
        exit 0' sh "$owner_link" "$holder" "$guest_app" "$1"
}

refuse_taken() {
    die "instance '$instance' in this VM belongs to $1; pass another with --instance. Release this VM with: scripts/vm down --instance $instance"
}

claim_instance() {
    local owner
    owner="$(link_owner_when_app_is absent)"
    [ -n "$owner" ] ||
        die "instance '$instance' is in this VM with no owner, so an earlier scripts/vm may still be using it; pass another with --instance. Only if it is yours: scripts/vm adopt --instance $instance"
    [ "$owner" = "$holder" ] || refuse_taken "$owner"
}

cmd_adopt() {
    local owner
    owner="$(link_owner_when_app_is installed)"
    [ -n "$owner" ] || die "no instance '$instance' in this VM; start one with: scripts/vm up --instance $instance"
    [ "$owner" = "$holder" ] || refuse_taken "$owner"
    echo "scripts/vm: $app is yours. When done: scripts/vm down --instance $instance"
}

require_own_instance() {
    local owner
    owner="$(instance_owner)"
    [ "$owner" = "$holder" ] ||
        die "instance '$instance' is not yours in this VM (owner: ${owner:-none}); start your own with: scripts/vm up"
}

wait_ready() {
    local started=$SECONDS deadline=$((SECONDS + READY_LIMIT_SECONDS))
    until bridge ping 2>/dev/null | grep -q '"frontendReady": true'; do
        [ "$SECONDS" -lt "$deadline" ] ||
            die "$app did not report frontendReady within ${READY_LIMIT_SECONDS}s (READY_LIMIT_SECONDS in scripts/vm); inspect it with: macvm exec cat .attn-$instance/daemon.log"
        sleep 2
    done
    echo "scripts/vm: $app ready after $((SECONDS - started))s" >&2
}

cmd_up() {
    [ -e app/node_modules/ws ] || pnpm --dir app install --frozen-lockfile
    if [ "$(bundle_fingerprint)" != "$(bash scripts/source-fingerprint.sh --field fingerprint)" ]; then
        if [ "$shell" = native ]; then
            make build-app INSTANCE="$instance" APP=native
        else
            make build-app INSTANCE="$instance" DEMO=1
        fi
    fi
    local vm
    vm="$(macvm up)"
    claim_instance
    if [ "$(guest_fingerprint)" != "$(bundle_fingerprint)" ]; then
        macvm exec osascript -e "quit app \"$app\"" 2>/dev/null || true
        macvm install-app "$bundle"
    fi
    macvm exec /bin/rm -rf "$harness"
    macvm push "$harness/app/scripts" app/scripts/real-app-harness
    macvm push "$harness/app/node_modules" "$(readlink -f app/node_modules/ws)"
    if [ "$shell" = native ]; then
        macvm exec open -g --env MAC_APP_QUIET=1 "$guest_app"
        wait_ready
    else
        macvm exec open -g "$guest_app"
        wait_ready
        bridge dismiss_whats_new '{}' >/dev/null
    fi
    echo "scripts/vm: $app is ready in $vm. When done: scripts/vm down${instance:+ --instance $instance}"
}

cmd_record() {
    [ $# -eq 2 ] || usage
    local seconds="$1" out="$2" guest="clips/$instance-$$.mp4" pulled
    macvm exec mkdir -p clips
    macvm exec macvm-record "$app" "$seconds" "$guest"
    pulled="$(mktemp -d)"
    macvm pull "$guest" "$pulled"
    mkdir -p "$(dirname "$out")"
    mv "$pulled/$(basename "$guest")" "$out"
    macvm exec /bin/rm -f "$guest"
    echo "scripts/vm: wrote $out"
}

cmd_shot() {
    [ $# -eq 1 ] || usage
    local out="$1" guest="shots/$instance-$$.png" pulled
    macvm exec mkdir -p shots
    if [ "$shell" = native ]; then
        bridge shot "{\"path\":\"/Users/admin/$guest\"}" >/dev/null
    else
        bridge capture_native_window_screenshot "{\"path\":\"/Users/admin/$guest\"}" >/dev/null
    fi
    pulled="$(mktemp -d)"
    macvm pull "$guest" "$pulled"
    mkdir -p "$(dirname "$out")"
    mv "$pulled/$(basename "$guest")" "$out"
    macvm exec /bin/rm -f "$guest"
    echo "scripts/vm: wrote $out"
}

cmd_down() {
    if [ "$(instance_owner)" = "$holder" ]; then
        macvm exec osascript -e "quit app \"$app\"" 2>/dev/null || true
        macvm exec "$guest_bin" instance clean "$instance" 2>/dev/null || true
        macvm exec /bin/rm -rf "$harness" "$guest_app" "$owner_link"
    elif [ -z "$(instance_owner)" ] && macvm exec /bin/test -e "$guest_app"; then
        echo "scripts/vm: instance '$instance' has no owner, so it was left in place; it goes when the VM stops" >&2
    fi
    macvm down
}

case "$command" in
up) cmd_up ;;
drive)
    [ ${#args[@]} -ge 1 ] || usage
    require_own_instance
    bridge "${args[@]}"
    ;;
record)
    require_own_instance
    cmd_record "${args[@]}"
    ;;
shot)
    require_own_instance
    cmd_shot "${args[@]}"
    ;;
down) cmd_down ;;
adopt) cmd_adopt ;;
*) usage ;;
esac
