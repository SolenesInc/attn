#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: ci-pass-records keys
       ci-pass-records carried <records dir>
       ci-pass-records passed

keys    prints "<group> <inputs key>" for each group in .github/ci-inputs.yml.
        The key hashes the index entries (mode, blob, path) of every tracked
        file except those the group and every_group leave out.
carried prints, as GitHub step outputs, "<group>=carried" for each pass record
        restored under <records dir>/<group>/record, then "carried=" and a JSON
        object naming each carried group's run and commit.
passed  prints "<group> <inputs key>" for each group whose CI jobs all
        succeeded. NEEDS_JSON is the Acceptance job's needs; JOB_GROUPS maps
        each gated job to the groups that gate it.
EOF
  exit 2
}

root="$(git rev-parse --show-toplevel)"
inputs="$root/.github/ci-inputs.yml"

group_entries() {
  awk -v file="$inputs" '
    /^[[:space:]]*(#.*)?$/ { next }
    /^[a-z_]+:$/ { group = substr($0, 1, length($0) - 1); print group "\tgroup"; next }
    /^  - \x27!?[^\x27!]+\x27$/ && group != "" {
      glob = substr($0, 6, length($0) - 6)
      kind = "unread"
      if (substr(glob, 1, 1) == "!") { kind = "read"; glob = substr(glob, 2) }
      if (kind == "unread" && glob ~ /^(\.github(\/|$)|\*\*)/) {
        printf "ci-pass-records: %s: %s leaves out files under .github/, which every group reads\n", file, glob > "/dev/stderr"
        exit 1
      }
      print group "\t" kind "\t" glob
      next
    }
    { printf "ci-pass-records: %s:%d: cannot read \"%s\"\n", file, NR, $0 > "/dev/stderr"; exit 1 }
  ' "$inputs"
}

keys() {
  local entries group
  entries="$(group_entries)"
  for group in $(awk -F'\t' '$2 == "group" && $1 != "every_group" { print $1 }' <<<"$entries"); do
    local unread=() kept=()
    while IFS=$'\t' read -r _ kind glob; do
      if [ "$kind" = unread ]; then
        unread+=(":(exclude,glob)$glob")
      else
        kept+=(":(glob)$glob")
      fi
    done < <(awk -F'\t' -v g="$group" '($1 == g || $1 == "every_group") && $2 != "group"' <<<"$entries")
    printf '%s %s\n' "$group" "$(
      {
        git -C "$root" ls-files -s -- . "${unread[@]}"
        if [ "${#kept[@]}" -gt 0 ]; then git -C "$root" ls-files -s -- "${kept[@]}"; fi
      } | sha256sum | cut -d' ' -f1
    )"
  done
}

carried() {
  local dir="${1:?ci-pass-records: carried needs the records directory}"
  local carried='{}' record group run commit
  for record in "$dir"/*/record; do
    [ -f "$record" ] || continue
    group="$(basename "$(dirname "$record")")"
    read -r run commit <"$record"
    echo "$group=carried"
    echo "$group carried: passed at $commit in $run" >&2
    carried="$(jq -c --arg group "$group" --arg run "$run" --arg commit "$commit" \
      '. + {($group): {run: $run, commit: $commit}}' <<<"$carried")"
  done
  echo "carried=$carried"
}

passed() {
  : "${NEEDS_JSON:?ci-pass-records: NEEDS_JSON is required}"
  : "${JOB_GROUPS:?ci-pass-records: JOB_GROUPS is required}"
  local green
  green="$(jq -c --argjson job_groups "$JOB_GROUPS" '. as $needs
    | [$job_groups | to_entries[] | {job: .key, group: .value[]}]
    | group_by(.group)
    | map(select(all(.[]; $needs[.job].result == "success")) | .[0].group)' <<<"$NEEDS_JSON")"
  keys | while read -r group key; do
    if jq -e --arg group "$group" 'index($group) != null' <<<"$green" >/dev/null; then
      printf '%s %s\n' "$group" "$key"
    fi
  done
}

case "${1:-}" in
  keys) keys ;;
  carried) carried "${2:-}" ;;
  passed) passed ;;
  *) usage ;;
esac
