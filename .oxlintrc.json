{
  "$schema": "./lint/node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./lint/anti-slop/index.ts"
    },
    {
      "name": "attn",
      "specifier": "./lint/attn/index.ts"
    }
  ],
  "rules": {
    "unicorn/no-thenable": "off",
    "no-control-regex": "off",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "oxc/no-accumulating-spread": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "sdk/*/test/**"
      ],
      "rules": {
        "attn/no-real-time-waits": [
          "error",
          {
            "allowed": {
              "sdk/plugin/test/client.test.ts": "sleeps with Bun.sleep; have the fake resolve a promise when the awaited call arrives"
            }
          }
        ],
        "attn/no-mocking-attn-modules": "error"
      }
    }
  ]
}
