{
  "name": "attn-mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:ghostty-vt": "bash ../app/scripts/ensure-ghostty-vt-wasm.sh",
    "dev": "pnpm run verify:ghostty-vt && vite",
    "build": "pnpm run verify:ghostty-vt && vite build",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src",
    "typecheck": "effect-tsgo tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@effect/platform-browser": "4.1.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "attn-apple-crypto": "file:native/crypto",
    "attn-keychain": "file:native/keychain",
    "attn-push": "file:native/push",
    "decode-named-character-reference": "1.3.0",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "11.16.1",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@effect/tsgo": "0.63.0",
    "@noble/ciphers": "2.4.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.6",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
