#!/usr/bin/env bash
set -euo pipefail

message_file="$1"

[ "${ATTN_INSIDE_APP:-}" = 1 ] || exit 0
command -v attn >/dev/null || exit 0
for replaying in rebase-merge rebase-apply; do
  [ -e "$(git rev-parse --git-path "$replaying")" ] && exit 0
done
[ -n "$(git stripspace --strip-comments <"$message_file")" ] || exit 0

session_id="$(attn presence --session-id 2>/dev/null)" || exit 0
trailers=(--trailer "Attn-Session: $session_id")
if seed_id="$(attn presence --seed-id 2>/dev/null)"; then
  trailers+=(--trailer "Attn-Seed: $seed_id")
fi
git interpret-trailers --in-place --if-exists doNothing "${trailers[@]}" "$message_file"
