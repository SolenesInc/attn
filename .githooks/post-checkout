#!/usr/bin/env bash
set -euo pipefail

[ "${3:-0}" = "1" ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$root/scripts/lib/libghostty-vt.sh" ] || exit 0

(
  unset GIT_DIR
  unset GIT_WORK_TREE
  cd "$root"
  # shellcheck disable=SC1091
  source "$root/scripts/lib/libghostty-vt.sh"
  platform="$(vt_default_platform 2>/dev/null)" || exit 0
  lib="$(vt_lib_for "$platform")"
  generated="$root/internal/ghosttyvt/native_paths_generated_$platform.go"
  if [ -f "$lib" ] && [ -f "$generated" ]; then
    exit 0
  fi
  lock_key="$(vt_lock_field key)"
  lock_sha="$(vt_lock_field "sha256_${platform}")"
  [ -n "$lock_key" ] && [ -n "$lock_sha" ] || exit 0
  [ "$(vt_key 2>/dev/null)" = "$lock_key" ] || exit 0
  cache_parent="$(vt_cache_root)/$platform"
  [ -d "$cache_parent" ] || exit 0
  cached="$(cd "$cache_parent" && pwd -P)/$lock_sha"
  [ -f "$cached/lib/libghostty-vt.a" ] || exit 0
  vt_use_artifact "$platform" "$cached"
) >/dev/null 2>&1 || true
